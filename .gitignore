# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
._*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and key files
.env*
/keys/*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

/generated/prisma

# Local package store and browser test reports
.pnpm-store/
playwright-report/
test-results/

# Private sandbox fixtures and verification artifacts
.billing-test/
.widget-test/

# Widget bundle generated by widget:sync for the local hosted page
/public/chat-widget-ui.iife.js
